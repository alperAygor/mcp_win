  "bonsai": {
    "runtime": "python",
    "version": "0.1.0",
    "tier": "experimental",
    "license": "MIT",
    "homepage": "https://github.com/JotaDeRodriguez/Bonsai_mcp",
    "pip": [
      "httpx>=0.28.1",
      "mcp[cli]>=1.4.1,<1.10",
      "pillow>=11.3.0"
    ],
    "git": {
      "repo": "https://github.com/JotaDeRodriguez/Bonsai_mcp.git",
      "commit": "1d8478f5d235dc27e2ab905cd7640f14070a41b4"
    },
    "copy": [
      [
        "tools.py",
        "app/tools.py"
      ],
      [
        "bc3_writer.py",
        "app/bc3_writer.py"
      ],
      [
        "list_ifc_entities.py",
        "app/list_ifc_entities.py"
      ],
      [
        "resources",
        "app/resources"
      ],
      [
        "addon.py",
        "addon/addon.py"
      ]
    ],
    "patches": [
      {
        "file": "app/tools.py",
        "from": "BlenderConnection(host=\"localhost\", port=9876)",
        "to": "BlenderConnection(host=\"localhost\", port=int(__import__(\"os\").environ.get(\"BONSAI_MCP_PORT\", \"9876\")))"
      }
    ],
    "launch": {
      "kind": "module",
      "target": "tools:main",
      "path": "app"
    }
  },
